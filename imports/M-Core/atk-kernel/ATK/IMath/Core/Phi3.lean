import Mathlib
import ATK.IMath.Core.Expr

namespace IMath

universe u

/-- The three semantic states of the extended numerical domain. -/
inductive State where
  | finite
  | infinite
  | indeterminate
deriving DecidableEq, Repr

/--
A conservative three-state extension of a carrier α.

Finite values remain ordinary α-values.
Infinity is a distinguished extended point.
Indeterminate values retain the expression that produced them.
-/
inductive Phi3 (α : Type u) where
  | finite : α → Phi3 α
  | infinity : Phi3 α
  | indeterminate : Expr α → Phi3 α
deriving Repr

namespace Phi3

/-- Classify a value by semantic state. -/
def state {α : Type u} : Phi3 α → State
  | .finite _ => .finite
  | .infinity => .infinite
  | .indeterminate _ => .indeterminate

/-- Recover the expression represented by a three-state value. -/
def toExpr {α : Type u} : Phi3 α → Expr α
  | .finite a => .value a
  | .infinity => .infinity
  | .indeterminate e => e

/-- Canonical indeterminate generated by the formal expression 0/0. -/
def I {α : Type u} [Zero α] : Phi3 α :=
  .indeterminate (.div (.value 0) (.value 0))

@[simp] theorem I_def {α : Type u} [Zero α] :
    I (α := α) = .indeterminate (.div (.value 0) (.value 0)) := rfl

@[simp] theorem state_I {α : Type u} [Zero α] :
    state (I (α := α)) = .indeterminate := rfl

@[simp] theorem state_infinity {α : Type u} :
    state (.infinity : Phi3 α) = .infinite := rfl

@[simp] theorem state_finite {α : Type u} (a : α) :
    state (.finite a : Phi3 α) = .finite := rfl

theorem finite_injective {α : Type u} :
    Function.Injective (@Phi3.finite α) := by
  intro a b h
  cases h
  rfl

theorem I_ne_infinity {α : Type u} [Zero α] :
    I (α := α) ≠ (.infinity : Phi3 α) := by
  intro h
  cases h

theorem I_ne_finite {α : Type u} [Zero α] (a : α) :
    I (α := α) ≠ (.finite a : Phi3 α) := by
  intro h
  cases h

end Phi3
end IMath
