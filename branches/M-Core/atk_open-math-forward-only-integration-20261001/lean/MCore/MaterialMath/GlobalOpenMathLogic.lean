import MCore.MaterialMath.GlobalMaterialTheorem
import MCore.MaterialMath.TwoSidedMaterialResolution

namespace MCore.MaterialMath

/--
Behavioral classes generated by the global material kernel.
These classify mechanisms, not mathematical subjects.
-/
inductive GlobalBehaviorClass
  | F1_vanishing
  | F2_gap
  | F4_realization
  | F5_equality
  | F6_exclusion
  | F7_limit
  | F8_fixedPoint
  | bilateralResolution
  deriving DecidableEq, Repr

/--
Evidence state of a mathematical endpoint.  The state is about material
producer inhabitation, not about excluded middle.
-/
inductive MaterialEvidenceState
  | openMath
  | positiveResolved
  | negativeResolved
  | inconsistentBoth
  deriving DecidableEq, Repr

/--
A problem-specific observable package.  The observable is the only legal place
where subject-specific mathematics enters the common kernel.
-/
structure ObservableAdapter
    (Source : Type*)
    (Observable : Type*)
    (Endpoint : Prop) where
  observe : Source → Observable
  admissible : Source → Prop
  closes : Observable → Endpoint

/--
A bilateral endpoint asks for two genuinely different material producers.
The framework never derives either producer from classical excluded middle.
-/
structure BilateralOpenMathProblem
    (PositiveProducer NegativeProducer : Type*) where
  endpoint : Prop
  positiveCloses : PositiveProducer → endpoint
  negativeCloses : NegativeProducer → ¬ endpoint

namespace BilateralOpenMathProblem

variable {PositiveProducer NegativeProducer : Type*}

def resolution
    (B : BilateralOpenMathProblem PositiveProducer NegativeProducer) :
    TwoSidedMaterialResolution
      B.endpoint PositiveProducer NegativeProducer where
  positiveCloses := B.positiveCloses
  negativeCloses := B.negativeCloses

def MateriallyResolved
    (B : BilateralOpenMathProblem PositiveProducer NegativeProducer) : Prop :=
  Nonempty PositiveProducer ∨ Nonempty NegativeProducer

theorem positive_outcome
    (B : BilateralOpenMathProblem PositiveProducer NegativeProducer)
    (h : Nonempty PositiveProducer) :
    B.endpoint :=
  (B.resolution).close_positive h

theorem negative_outcome
    (B : BilateralOpenMathProblem PositiveProducer NegativeProducer)
    (h : Nonempty NegativeProducer) :
    ¬ B.endpoint :=
  (B.resolution).close_negative h

theorem both_is_inconsistent
    (B : BilateralOpenMathProblem PositiveProducer NegativeProducer)
    (hp : Nonempty PositiveProducer)
    (hn : Nonempty NegativeProducer) :
    False :=
  (B.resolution).both_material_routes_contradict hp hn

end BilateralOpenMathProblem

/--
Five audit questions that every purported open-math closure must answer.
They are represented as data requirements rather than prose.
-/
structure ClosureAudit
    (Producer Observable : Type*)
    (Endpoint : Prop) where
  producerToObservable : Producer → Observable
  observableToEndpoint : Observable → Endpoint
  producerNonempty : Prop
  noEndpointStored : Prop
  domainPreserved : Prop
  scalingPreserved : Prop
  countermodelSafe : Prop

/--
A closure audit is material only when an actual producer exists and all
firewalls are discharged.
-/
def ClosureAudit.MateriallyComplete
    {Producer Observable : Type*}
    {Endpoint : Prop}
    (A : ClosureAudit Producer Observable Endpoint) : Prop :=
  A.producerNonempty ∧
  A.noEndpointStored ∧
  A.domainPreserved ∧
  A.scalingPreserved ∧
  A.countermodelSafe

/--
The common logical form of a valid closure:
material producer -> exact observable -> official endpoint.
-/
theorem close_from_material_audit
    {Producer Observable : Type*}
    {Endpoint : Prop}
    (A : ClosureAudit Producer Observable Endpoint)
    (p : Producer) :
    Endpoint :=
  A.observableToEndpoint (A.producerToObservable p)

/--
The global question protocol: the internal kernel can provide mechanisms and
exact invariants, but an open problem closes only through a problem-specific
producer and an exact endpoint transport.
-/
structure GlobalQuestionProtocol where
  askPositiveProducer : Prop
  askNegativeProducer : Prop
  askCanonicalObservable : Prop
  askExactTransport : Prop
  askCountermodelFirewall : Prop

def canonicalGlobalQuestionProtocol : GlobalQuestionProtocol where
  askPositiveProducer := True
  askNegativeProducer := True
  askCanonicalObservable := True
  askExactTransport := True
  askCountermodelFirewall := True

theorem canonicalGlobalQuestionProtocol_complete :
    canonicalGlobalQuestionProtocol.askPositiveProducer ∧
    canonicalGlobalQuestionProtocol.askNegativeProducer ∧
    canonicalGlobalQuestionProtocol.askCanonicalObservable ∧
    canonicalGlobalQuestionProtocol.askExactTransport ∧
    canonicalGlobalQuestionProtocol.askCountermodelFirewall := by
  simp [canonicalGlobalQuestionProtocol]

