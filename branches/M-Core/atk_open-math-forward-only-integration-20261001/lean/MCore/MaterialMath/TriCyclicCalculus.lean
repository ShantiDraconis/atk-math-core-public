import MCore.MaterialMath.TriCyclicAlgebra

namespace MCore.MaterialMath

namespace TriNumber

variable {α : Type*}

/-- First cyclic phase derivative D = R - I. -/
def phaseDerivative [Sub α] (x : TriNumber α) : TriNumber α where
  manifest := x.seed - x.manifest
  crossing := x.manifest - x.crossing
  seed := x.crossing - x.seed

/-- Symmetric cyclic Laplacian on the three phases. -/
def phaseLaplacian [Ring α] (x : TriNumber α) : TriNumber α where
  manifest := x.crossing + x.seed - 2 * x.manifest
  crossing := x.seed + x.manifest - 2 * x.crossing
  seed := x.manifest + x.crossing - 2 * x.seed

theorem phaseDerivative_rotate [AddGroup α] (x : TriNumber α) :
    phaseDerivative (rotate x) = rotate (phaseDerivative x) := by
  cases x
  rfl

theorem phaseLaplacian_rotate [Ring α] (x : TriNumber α) :
    phaseLaplacian (rotate x) = rotate (phaseLaplacian x) := by
  cases x
  rfl

theorem total_phaseDerivative [AddCommGroup α] (x : TriNumber α) :
    total (phaseDerivative x) = 0 := by
  cases x
  simp [total, phaseDerivative]

theorem total_phaseLaplacian [CommRing α] (x : TriNumber α) :
    total (phaseLaplacian x) = 0 := by
  cases x
  simp [total, phaseLaplacian]
  ring

theorem phaseDerivative_eq_zero_iff_balanced [AddGroup α] (x : TriNumber α) :
    phaseDerivative x = { manifest := 0, crossing := 0, seed := 0 } ↔ Balanced x := by
  cases x with
  | mk m c s =>
      simp [phaseDerivative, Balanced]
      constructor
      · rintro ⟨hsm, hmc, hcs⟩
        constructor
        · exact sub_eq_zero.mp hmc
        · exact sub_eq_zero.mp hcs
      · rintro ⟨hmc, hcs⟩
        subst c
        subst s
        simp

/-- The Laplacian vanishes on balanced states. -/
theorem phaseLaplacian_of_balanced [Ring α]
    {x : TriNumber α} (h : Balanced x) :
    phaseLaplacian x = { manifest := 0, crossing := 0, seed := 0 } := by
  rcases x with ⟨m, c, s⟩
  rcases h with ⟨hmc, hcs⟩
  change m = c at hmc
  change c = s at hcs
  subst c
  subst s
  apply TriNumber.ext <;> simp [phaseLaplacian, two_mul]

/-- Real spread is nonnegative. -/
theorem spread_nonneg (x : TriNumber ℝ) :
    0 ≤ spread x := by
  dsimp [spread]
  positivity

/-- Real spread is zero exactly on the balanced subspace. -/
theorem spread_eq_zero_iff_balanced (x : TriNumber ℝ) :
    spread x = 0 ↔ Balanced x := by
  rcases x with ⟨m, c, s⟩
  constructor
  · intro h
    have h1 : (m - c)^2 = 0 := by
      have a := sq_nonneg (m - c)
      have b := sq_nonneg (c - s)
      have d := sq_nonneg (s - m)
      dsimp [spread] at h
      nlinarith
    have h2 : (c - s)^2 = 0 := by
      have a := sq_nonneg (m - c)
      have b := sq_nonneg (c - s)
      have d := sq_nonneg (s - m)
      dsimp [spread] at h
      nlinarith
    have hmc : m = c := by
      nlinarith [sq_nonneg (m - c)]
    have hcs : c = s := by
      nlinarith [sq_nonneg (c - s)]
    exact ⟨hmc, hcs⟩
  · rintro ⟨hmc, hcs⟩
    change m = c at hmc
    change c = s at hcs
    subst c
    subst s
    simp [spread]

/-- A real phase state with positive spread is genuinely non-balanced. -/
theorem positive_spread_implies_not_balanced
    (x : TriNumber ℝ) (h : 0 < spread x) :
    ¬ Balanced x := by
  intro hb
  have hz := (spread_eq_zero_iff_balanced x).2 hb
  linarith

/-- Phase energy is the spread, named for dynamical use. -/
abbrev phaseEnergy (x : TriNumber ℝ) : ℝ :=
  spread x

/-- Cyclic rotation conserves phase energy. -/
theorem phaseEnergy_rotate (x : TriNumber ℝ) :
    phaseEnergy (rotate x) = phaseEnergy x :=
  spread_rotate x

/-- A material trajectory is a time-indexed tri-state. -/
abbrev Trajectory (T : Type*) (α : Type*) :=
  T → TriNumber α

/-- Pointwise phase derivative of a trajectory. -/
def trajectoryPhaseDerivative [Sub α]
    {T : Type*} (x : Trajectory T α) : Trajectory T α :=
  fun t => phaseDerivative (x t)

/-- Pointwise cyclic Laplacian of a trajectory. -/
def trajectoryPhaseLaplacian [Ring α]
    {T : Type*} (x : Trajectory T α) : Trajectory T α :=
  fun t => phaseLaplacian (x t)

end TriNumber

/-- Algebraic behavior classes generated by the tri-cyclic calculus. -/
inductive MaterialBehavior where
  | balanced
  | zeroSum
  | rotating
  | torsional
  | dispersive
  | singular
  deriving DecidableEq, Repr

end MCore.MaterialMath
