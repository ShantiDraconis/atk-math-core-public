import MCore.MaterialMath.TriState.Algebra

namespace MCore.MaterialMath

open Phase3
open TriNumber

namespace TriAlgebra

theorem rotate_zero
    {α : Type*} [Zero α] :
    TriNumber.rotate (0 : TriNumber α) = 0 := by
  rfl

theorem rotate_one
    {α : Type*} [One α] :
    TriNumber.rotate (1 : TriNumber α) = 1 := by
  rfl

theorem rotate_add
    {α : Type*} [Add α]
    (x y : TriNumber α) :
    TriNumber.rotate (x + y) = TriNumber.rotate x + TriNumber.rotate y := by
  rfl

theorem rotate_neg
    {α : Type*} [Neg α]
    (x : TriNumber α) :
    TriNumber.rotate (-x) = - TriNumber.rotate x := by
  rfl

theorem rotate_sub
    {α : Type*} [Sub α]
    (x y : TriNumber α) :
    TriNumber.rotate (x - y) = TriNumber.rotate x - TriNumber.rotate y := by
  rfl

theorem rotate_mul
    {α : Type*} [Mul α]
    (x y : TriNumber α) :
    TriNumber.rotate (x * y) = TriNumber.rotate x * TriNumber.rotate y := by
  rfl

theorem rotate_pow
    {α : Type*} [Monoid α]
    (x : TriNumber α) (n : Nat) :
    TriNumber.rotate (x ^ n) = TriNumber.rotate x ^ n := by
  funext p
  rfl

/-- Phase Kronecker coordinate. -/
def delta
    {α : Type*} [Zero α] [One α]
    (p : Phase3) : TriNumber α :=
  fun q => if q = p then 1 else 0

@[simp] theorem delta_self
    {α : Type*} [Zero α] [One α]
    (p : Phase3) :
    delta (α := α) p p = 1 := by
  simp [delta]

@[simp] theorem delta_of_ne
    {α : Type*} [Zero α] [One α]
    {p q : Phase3}
    (h : q ≠ p) :
    delta (α := α) p q = 0 := by
  simp [delta, h]

/-- Every tri-number decomposes into its three phase coordinates. -/
theorem coordinate_decomposition
    {α : Type*} [Semiring α]
    (x : TriNumber α) :
    x =
      (fun p => x .seed * delta (α := α) .seed p) +
      (fun p => x .passage * delta (α := α) .passage p) +
      (fun p => x .manifest * delta (α := α) .manifest p) := by
  funext p
  cases p <;> simp [delta]

/-- The three distinguished orbit states generated by I3. -/
def J3 : TriNumber Int := TriNumber.rotate I3
def K3 : TriNumber Int := TriNumber.rotate2 I3

theorem I3_to_J3 : TriNumber.rotate I3 = J3 := rfl
theorem J3_to_K3 : TriNumber.rotate J3 = K3 := rfl
theorem K3_to_I3 : TriNumber.rotate K3 = I3 := by
  simpa [J3, K3, TriNumber.rotate2] using I3_rotation_period_three

theorem I3_ne_J3 : I3 ≠ J3 := by
  intro h
  have hs := congrFun h Phase3.seed
  norm_num [I3, J3, TriNumber.rotate, Phase3.rotate] at hs

theorem J3_ne_K3 : J3 ≠ K3 := by
  intro h
  have hs := congrFun h Phase3.seed
  norm_num [I3, J3, K3, TriNumber.rotate, TriNumber.rotate2, Phase3.rotate] at hs

theorem K3_ne_I3 : K3 ≠ I3 := by
  intro h
  have hs := congrFun h Phase3.seed
  norm_num [I3, K3, TriNumber.rotate2, TriNumber.rotate, Phase3.rotate] at hs

theorem orbit_three_distinct :
    I3 ≠ J3 ∧ J3 ≠ K3 ∧ K3 ≠ I3 :=
  ⟨I3_ne_J3, J3_ne_K3, K3_ne_I3⟩

end TriAlgebra

end MCore.MaterialMath
