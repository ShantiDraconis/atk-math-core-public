import MCore.MaterialMath.TriState.NumericClasses

namespace MCore.MaterialMath

open Phase3
open TriNumber
open TriArithmetic
open TriDynamics

namespace TriSpectral

/-- Constant coherent tri-number generated by one scalar. -/
def constant
    {α : Type*}
    (a : α) : TriNumber α :=
  fun _ => a

theorem constant_coherent
    {α : Type*}
    (a : α) :
    TriNumber.Coherent (constant a) := by
  exact ⟨rfl, rfl⟩

/-- Every tri-number decomposes into its coherent mean part plus its centered part. -/
theorem mean_center_decomposition
    {α : Type*} [Field α] [LinearOrder α] [IsStrictOrderedRing α]
    (x : TriNumber α) :
    x = fun p => constant (phaseMean x) p + center x p := by
  funext p
  simp [constant, center]

/-- On the balanced subspace the 3-cycle Laplacian is exactly -3 times identity. -/
theorem laplacian_eq_neg_three_of_balanced
    {α : Type*} [Field α] [LinearOrder α] [IsStrictOrderedRing α]
    {x : TriNumber α}
    (h : TriNumber.Balanced x) :
    TriNumber.laplacian x = fun p => (-3 : α) * x p := by
  have hs : x .seed + x .passage + x .manifest = 0 := h
  funext p
  cases p <;>
    simp [TriNumber.laplacian, Phase3.rotate, Phase3.rotate2] <;>
    linarith

/-- The centered component is therefore a -3 eigenvector of the Laplacian. -/
theorem laplacian_center
    {α : Type*} [Field α] [LinearOrder α] [IsStrictOrderedRing α]
    (x : TriNumber α) :
    TriNumber.laplacian (center x) =
      fun p => (-3 : α) * center x p :=
  laplacian_eq_neg_three_of_balanced (center_balanced x)

/-- The coherent component lies in the zero eigenspace. -/
theorem laplacian_constant_zero
    {α : Type*} [Field α] [LinearOrder α] [IsStrictOrderedRing α]
    (a : α) :
    TriNumber.laplacian (constant a) = 0 := by
  exact coherent_implies_harmonic (constant_coherent a)

/-- Spectral dichotomy for the tri-state Laplacian:
coherent mode has eigenvalue 0, centered/balanced mode has eigenvalue -3. -/
theorem spectral_split
    {α : Type*} [Field α] [LinearOrder α] [IsStrictOrderedRing α]
    (x : TriNumber α) :
    TriDynamics.Harmonic (constant (phaseMean x)) ∧
    TriNumber.Balanced (center x) ∧
    TriNumber.laplacian (center x) =
      fun p => (-3 : α) * center x p := by
  exact ⟨
    coherent_implies_harmonic (constant_coherent (phaseMean x)),
    center_balanced x,
    laplacian_center x
  ⟩

/-- Rotation preserves both eigenspaces. -/
theorem coherent_and_balanced_rotation_invariant
    {α : Type*} [Field α] [LinearOrder α] [IsStrictOrderedRing α]
    (x : TriNumber α) :
    (TriNumber.Coherent x → TriNumber.Coherent (TriNumber.rotate x)) ∧
    (TriNumber.Balanced x → TriNumber.Balanced (TriNumber.rotate x)) := by
  exact ⟨coherent_rotate, balanced_rotate⟩

end TriSpectral

end MCore.MaterialMath
