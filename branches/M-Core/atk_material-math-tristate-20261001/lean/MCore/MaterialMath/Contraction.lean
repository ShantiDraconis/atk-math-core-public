import MCore.MaterialMath.TerminalPatterns

namespace MCore.MaterialMath

/-- A nonnegative real sequence with a uniform one-step contraction. -/
structure GeometricContraction (a : Nat → ℝ) where
  factor : ℝ
  factor_nonneg : 0 ≤ factor
  factor_lt_one : factor < 1
  sequence_nonneg : ∀ n, 0 ≤ a n
  step : ∀ n, a (n + 1) ≤ factor * a n

/-- Exact geometric envelope generated by a strict contraction law. -/
theorem geometric_bound
    {a : Nat → ℝ}
    (G : GeometricContraction a) :
    ∀ n, a n ≤ G.factor ^ n * a 0 := by
  intro n
  induction n with
  | zero =>
      simp
  | succ n ih =>
      calc
        a (n + 1) ≤ G.factor * a n := G.step n
        _ ≤ G.factor * (G.factor ^ n * a 0) :=
          mul_le_mul_of_nonneg_left ih G.factor_nonneg
        _ = G.factor ^ (n + 1) * a 0 := by
          rw [pow_succ]
          ring

/-- Strict contraction factors automatically satisfy the F7 StrictBudget
coefficient side. -/
theorem contraction_factor_is_strict_budget_coefficient
    {a : Nat → ℝ}
    (G : GeometricContraction a) :
    0 ≤ G.factor ∧ G.factor < 1 :=
  ⟨G.factor_nonneg, G.factor_lt_one⟩

/-- A zero initial state remains identically zero under a nonnegative
geometric contraction. -/
theorem geometric_zero_initial
    {a : Nat → ℝ}
    (G : GeometricContraction a)
    (h0 : a 0 = 0) :
    ∀ n, a n = 0 := by
  intro n
  have hupper := geometric_bound G n
  have hnonneg := G.sequence_nonneg n
  rw [h0, mul_zero] at hupper
  linarith

end MCore.MaterialMath
